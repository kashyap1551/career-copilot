# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real job ads and their answer keys: git history is permanent and the repo
# may go public (see docs/DECISIONS.md). SOURCES.md and known-cases/ are committed.
# Everything in fixtures/real-ads/ is ignored except SOURCES.md: every file type
# (.txt, .json, .md, .pdf, .csv, .docx) and every subfolder.
/fixtures/real-ads/*
!/fixtures/real-ads/SOURCES.md
/fixtures/answer-keys/

# results of `npm run eval`
/eval-runs/

# local Claude Code settings (may hold pasted paths or tokens)
.claude/settings.local.json
